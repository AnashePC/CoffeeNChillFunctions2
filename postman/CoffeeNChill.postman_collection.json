    {
      "name": "Orders (Part 2)",
      "item": [
        {
          "name": "1. Producer – POST /orders/queue",
          "item": [
            {
              "name": "Queue valid order – 202",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const id = \"ORD-\" + new Date().getFullYear() + \"-\" + Math.floor(1000 + Math.random()*9000);",
                      "pm.collectionVariables.set(\"orderId\", id);",
                      "pm.collectionVariables.set(\"orderTimestamp\", new Date().toISOString());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"202 Accepted – client not blocked\",()=>pm.response.to.have.status(202));",
                      "const j=pm.response.json();",
                      "pm.test(\"Echoes OrderId\",()=>pm.expect(j.orderId).to.eql(pm.collectionVariables.get(\"orderId\")));",
                      "pm.test(\"Returns status URL\",()=>pm.expect(j.statusUrl).to.include(\"/api/orders/\"));",
                      "pm.test(\"Responds quickly (async)\",()=>pm.expect(pm.response.responseTime).to.be.below(2000));",
                      "pm.collectionVariables.set(\"orderDate\", j.orderDate);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"OrderId\": \"{{orderId}}\",\n  \"CustomerName\": \"Jane Smith\",\n  \"SelectedItemSKUs\": [\n    \"COF-001\",\n    \"PAS-104\"\n  ],\n  \"TotalPrice\": 65,\n  \"OrderTimestamp\": \"{{orderTimestamp}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/orders/queue",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "orders",
                    "queue"
                  ]
                },
                "description": "Pre-request script generates a unique OrderId and a current timestamp. Run requests in this folder in order."
              }
            },
            {
              "name": "Queue order without OrderTimestamp (server generates) – 202",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"202 Accepted\",()=>pm.response.to.have.status(202));",
                      "pm.test(\"Timestamp generated\",()=>pm.expect(pm.response.json().orderTimestamp).to.be.a(\"string\"));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"OrderId\": \"ORD-2026-{{$randomInt}}\",\n  \"CustomerName\": \"Thabo Mokoena\",\n  \"SelectedItemSKUs\": [\n    \"COF-002\"\n  ],\n  \"TotalPrice\": 32.5\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/orders/queue",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "orders",
                    "queue"
                  ]
                }
              }
            },
